# Copie este archivo a .env y complete los valores reales.
# NUNCA suba el archivo .env al repositorio.

# Cadena de conexión a PostgreSQL (Neon u otro proveedor)
DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require

# Secreto para firmar los JWT. Genere uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000

# --- Correo (opcional; si se omite, el sistema sigue funcionando sin enviar correos) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dirección que recibe las alertas automáticas de indicadores en estado Crítico
ALERTA_EMAIL_DESTINO=

# Expresión cron para la revisión diaria de alertas (por defecto: 08:00 todos los días)
ALERTA_CRON=0 8 * * *
